{
  "$schema": "https://app.kilo.ai/config.json", // Schema validation
  
  // Custom Agent Skills Configuration
  "skills": {
    "paths": [".kilo/skills"]
  },

  // Project-wide custom rules and instruction files
  "instructions": [
  ],
  "mcp": {
    "appium-mcp": {
      "enabled": true,
      "timeout": 10000,
      "type": "stdio",
      "command": ["npx", "appium-mcp@latest"],
      "environment": {
        "APPIUM_HOST": "127.0.0.1",
        "APPIUM_PORT": "4723"
      }
    }
  }
}