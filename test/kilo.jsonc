{
  "$schema": "https://app.kilo.ai/config.json",

  "skills": {
    "paths": [".kilo/skills"]
  },

  "instructions": [],

  "mcp": {
    "appium-mcp": {
      "enabled": true,
      "timeout": 10000,
      "type": "stdio",
      "command": ["node", "C:\\Users\\user\\AppData\\Roaming\\npm\\node_modules\\appium-mcp\\dist\\index.js"],
      "environment": {
        "APPIUM_HOST": "127.0.0.1",
        "APPIUM_PORT": "4723"
      }
    }
  },

  "permission": {
    "appium-mcp_*": "allow"
  }
}