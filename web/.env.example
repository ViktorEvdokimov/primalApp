# Настройки сайта. Скопируйте в .env: значения ниже подходят для запуска на своём компьютере.
# На сервере замените их по doc/setup.md, раздел 3.6. Описание всех переменных — раздел 5.

# ── Адрес сайта ─────────────────────────────────────────────────────────────────
# Локально ":80" — сайт по HTTP. На сервере — ваш домен (primal.example.ru), и Caddy сам включит HTTPS.
SITE_ADDRESS=:80
# Порты на компьютере или сервере: локально 8088/8443, на сервере 80/443.
HTTP_PORT=8088
HTTPS_PORT=8443
# Адрес для пользователей: из него строятся ссылки-приглашения; https:// включает защищённые cookie.
PUBLIC_URL=http://localhost:8088

# ── База данных ─────────────────────────────────────────────────────────────────
POSTGRES_DB=primal
POSTGRES_USER=primal
# Действует только при первом создании БД (doc/setup.md, раздел 3.11).
POSTGRES_PASSWORD=primal-local-password

# ── Секреты: на сервере обязательно замените (openssl rand -hex 32) ──────────────
PRIMAL_OTP_PEPPER=local-dev-otp-pepper-change-me
# Не меняйте на работающем сайте: все ссылки-приглашения перестанут работать.
PRIMAL_SHARE_LINK_KEY=local-dev-share-key-change-me

# ── Почта ───────────────────────────────────────────────────────────────────────
# Локально — Mailpit (письма видны на http://localhost:8025). На сервере — SMTP почтового сервиса.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# none — без шифрования (Mailpit), starttls — порт 587, ssl — порт 465
SMTP_TLS=none
MAIL_FROM=Primal <no-reply@primal.local>

# ── Ограничения частоты с одного IP (doc/architecture.md §6) ─────────────────────
# На сервере не задавайте: по умолчанию 20 писем с кодом и 60 проверок кода в час.
# Локально E2E-тесты входят много раз с одного адреса, поэтому лимит писем поднят.
PRIMAL_CODES_PER_IP_HOUR=500
PRIMAL_VERIFICATIONS_PER_IP_HOUR=1000
PRIMAL_JOINS_PER_IP_HOUR=1000
