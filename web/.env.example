# Настройки сайта. Скопируйте в .env: значения ниже подходят для запуска на своём компьютере.
# На сервере замените их по doc/setup.md, раздел 3.6. Описание всех переменных — раздел 5.

# ── Адрес сайта ─────────────────────────────────────────────────────────────────
# Локально ":80" — сайт по HTTP. На сервере — ваш домен (primal.example.ru), и Caddy сам включит HTTPS.
SITE_ADDRESS=:80
# Порты на компьютере или сервере: локально 8088/8443, на сервере 80/443.
HTTP_PORT=8088
HTTPS_PORT=8443
# Адрес для пользователей: из него строятся ссылки-приглашения; https:// включает защищённые cookie.
PUBLIC_URL=http://localhost:8088

# ── База данных ─────────────────────────────────────────────────────────────────
POSTGRES_DB=primal
POSTGRES_USER=primal
# Действует только при первом создании БД (doc/setup.md, раздел 3.11).
POSTGRES_PASSWORD=primal-local-password

# ── Секрет: на сервере обязательно замените (openssl rand -hex 32) ───────────────
# Не меняйте на работающем сайте: все ссылки-приглашения перестанут работать.
PRIMAL_SHARE_LINK_KEY=local-dev-share-key-change-me

# ── Почта ───────────────────────────────────────────────────────────────────────
# Пока не используется: вход — по логину и паролю. Настройки оставлены для будущих писем.
# Способ отправки (doc/setup.md, раздел 3.3):
#   smtp    — через SMTP_* ниже. Локально — Mailpit: письма видны на http://localhost:8025 (нужен для E2E);
#   mailgun — настоящие письма через HTTP API Mailgun, переменные MAILGUN_*.
MAIL_PROVIDER=smtp
# Mailgun: регион US — https://api.mailgun.net, EU — https://api.eu.mailgun.net. Ключ — секрет, не публикуйте.
# Sandbox-домен доставляет только на адреса из «Authorized Recipients» в панели Mailgun.
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# none — без шифрования (Mailpit), starttls — порт 587, ssl — порт 465
SMTP_TLS=none
# Отправитель. Для Mailgun — адрес на домене MAILGUN_DOMAIN: Primal <postmaster@ваш-домен>.
MAIL_FROM=Primal <no-reply@primal.local>

# ── Ограничения частоты с одного IP (doc/architecture.md §6) ─────────────────────
# На сервере не задавайте: по умолчанию 20 регистраций и 60 попыток входа в час.
# Локально E2E-тесты регистрируются много раз с одного адреса, поэтому лимиты подняты.
PRIMAL_REGISTRATIONS_PER_IP_HOUR=500
PRIMAL_LOGINS_PER_IP_HOUR=1000
PRIMAL_JOINS_PER_IP_HOUR=1000
